{
	"trailingComma": "all",
	"printWidth": 80,
	"useTabs": true,
	"plugins": ["prettier-plugin-tailwindcss"],
	"tailwindStylesheet": "./apps/a8-web/src/index.css",
	"overrides": [
		{
			"files": ["**/*.md"],
			"options": {
				"tabWidth": 2,
				"useTabs": false
			}
		},
		{
			"files": ["**/package.json"],
			"options": {
				"tabWidth": 2,
				"useTabs": false
			}
		}
	]
}
